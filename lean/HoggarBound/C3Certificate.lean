/- Kernel-checked finite certificate for a four-qubit C3 sign-carrier pair. -/
import HoggarBound.C3Data
import HoggarBound.Quadric
import Mathlib.LinearAlgebra.Matrix.Charpoly.Basic

open Matrix Finset

namespace HoggarBound.C3

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- Exact integral intertwining identity, with no eigenvalue approximation. -/
theorem carrier_intertwining : carrierA * intertwiner = intertwiner * carrierB := by
  decide +kernel

/-- A two-sided inverse numerator certifies invertibility without determinant expansion. -/
theorem intertwiner_inverse : intertwiner * inverseNumerator = (46656 : ℤ) • 1 := by
  decide +kernel

theorem intertwiner_det_ne_zero : intertwiner.det ≠ 0 := by
  intro hzero
  have h := congrArg Matrix.det intertwiner_inverse
  rw [Matrix.det_mul, hzero, zero_mul, Matrix.det_smul, Matrix.det_one] at h
  norm_num at h

/-- **The two carriers have exactly the same characteristic polynomial.** -/
theorem carrier_charpoly_eq : carrierA.charpoly = carrierB.charpoly :=
  Matrix.charpoly_eq_of_mul_eq_mul intertwiner_det_ne_zero carrier_intertwining

