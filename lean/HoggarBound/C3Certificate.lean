private theorem completionB_square : completionB * completionB = completionSquareB := by
  ext i j
  fin_cases i <;> revert j <;> decide +kernel

/-- Exact cubic trace via a separately checked intermediate square. -/
theorem completionB_trace_cube : (completionB ^ 3).trace = 15360 := by
  rw [show (3 : ℕ) = 2 + 1 by rfl, pow_succ, pow_two, completionB_square]
  decide +kernel

theorem completion_cube_traces_ne : (completionA ^ 3).trace ≠ (completionB ^ 3).trace := by
  rw [completionA_trace_cube, completionB_trace_cube]
  norm_num

