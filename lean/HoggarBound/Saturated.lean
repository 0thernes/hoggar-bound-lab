/-
Hoggar Bound Lab — configurations on which the spectral floor is attained.

Six configurations of Pauli observables, each given by a bit mask (`FlatData.lean`), with their exact
contextuality degrees.  The lower bounds are instances of `hoggar_bound`; the upper bounds are explicit
assignments; the finite counts that connect the two are evaluated by the kernel (`MaskConfig.lean`,
`SaturatedFive.lean`).

* `pivot_degree`        four qubits, 135 observables, 1095 contexts: degree exactly 75
* `cieslinski5_degree`  five qubits, 496 observables, 10880 contexts: degree exactly 480
* `quadric_degree`      four qubits, 135 observables, 1575 contexts: degree exactly 315
* `hoggar_degree`       three qubits, 63 observables, 315 contexts: degree exactly 63
* `ccz_degree`, `lly_degree`   28 and 12 observables: degree 0

All statements are about the explicit complex Pauli matrices of `Pauli.lean`.  The masks are generated by
`scripts/flat_states.py`, which also checks in exact arithmetic that they are the supports and sign
patterns of six explicit quantum states; that link is not needed for, and not part of, what is proved here.

No `native_decide`; the axioms are the standard three.
-/
import HoggarBound.MaskConfig
import HoggarBound.FlatData
import HoggarBound.SaturatedFive

open Finset Matrix

namespace HoggarBound

open FlatData

/-! ### Kernel-evaluated counts for two, three and four qubits -/

section certificates

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

/-! #### Two qubits: the support of the Liu–Low–Yin state (12 observables, 8 contexts) -/

theorem lly_card : (cfg 2 llyMask).card = 12 := by
  rw [card_cfg, card_codes]; decide +kernel

theorem lly_flags : (flags (cfg 2 llyMask)).card = 48 := by
  rw [card_flags_cfg]; decide +kernel

theorem lly_witness :
    (violated (cfg 2 llyMask) (fun u => ((sgnOf 2 llyNeg u : ℤ) : ℝ))).card = 6 * 0 := by
  rw [card_violated_cfg]; decide +kernel

/-! #### Three qubits: the support of `CCZ|+++⟩` (28 observables, 56 contexts) -/

theorem ccz_card : (cfg 3 cczMask).card = 28 := by
  rw [card_cfg, card_codes]; decide +kernel

theorem ccz_flags : (flags (cfg 3 cczMask)).card = 336 := by
  rw [card_flags_cfg]; decide +kernel

theorem ccz_witness :
    (violated (cfg 3 cczMask) (fun u => ((sgnOf 3 cczNeg u : ℤ) : ℝ))).card = 6 * 0 := by
  rw [card_violated_cfg]; decide +kernel

/-! #### Three qubits: all 63 observables, with the Hoggar signs -/

theorem hoggar_card : (cfg 3 hoggarMask).card = 63 := by
  rw [card_cfg, card_codes]; decide +kernel

theorem hoggar_flags : (flags (cfg 3 hoggarMask)).card = 1890 := by
  rw [card_flags_cfg]; decide +kernel

theorem hoggar_witness :
    (violated (cfg 3 hoggarMask) (fun u => ((sgnOf 3 hoggarNeg u : ℤ) : ℝ))).card = 6 * 63 := by
  rw [card_violated_cfg]; decide +kernel

/-! #### Four qubits: the hyperbolic quadric (135 observables, 1575 contexts) -/

theorem quadric_card : (cfg 4 quadricMask).card = 135 := by
  rw [card_cfg, card_codes]; decide +kernel

theorem quadric_flags : (flags (cfg 4 quadricMask)).card = 9450 := by
  rw [card_flags_cfg]; decide +kernel

theorem quadric_witness :
    (violated (cfg 4 quadricMask) (fun u => ((sgnOf 4 quadricNeg u : ℤ) : ℝ))).card = 6 * 315 := by
  rw [card_violated_cfg]; decide +kernel

/-! #### Four qubits: the pivot configuration (135 observables, 1095 contexts) -/

theorem pivot_card : (cfg 4 pivotMask).card = 135 := by
  rw [card_cfg, card_codes]; decide +kernel

theorem pivot_flags : (flags (cfg 4 pivotMask)).card = 6570 := by
  rw [card_flags_cfg]; decide +kernel

theorem pivot_witness :
    (violated (cfg 4 pivotMask) (fun u => ((sgnOf 4 pivotNeg u : ℤ) : ℝ))).card = 6 * 75 := by
  rw [card_violated_cfg]; decide +kernel

end certificates

/-! ### Exact degrees -/

/-- **Two qubits.**  The 12 observables outside a maximal commuting set, with their 8 contexts,
are noncontextual: some assignment violates no context. -/
theorem lly_degree :
    (∀ f : Pt 2 → ℝ, (∀ u ∈ cfg 2 llyMask, f u = 1 ∨ f u = -1) →
        0 ≤ (violatedLines (cfg 2 llyMask) f).card) ∧
      ∃ f : Pt 2 → ℝ, (∀ u, f u = 1 ∨ f u = -1) ∧ (violatedLines (cfg 2 llyMask) f).card = 0 :=
  degree_of_certificate (by norm_num) llyMask llyNeg 12 48 0 6 (by norm_num) (by decide)
    lly_card lly_flags lly_witness (by norm_num) (by norm_num)

/-- **Three qubits, 28 observables.**  The support of `CCZ|+++⟩` is noncontextual. -/
theorem ccz_degree :
    (∀ f : Pt 3 → ℝ, (∀ u ∈ cfg 3 cczMask, f u = 1 ∨ f u = -1) →
        0 ≤ (violatedLines (cfg 3 cczMask) f).card) ∧
      ∃ f : Pt 3 → ℝ, (∀ u, f u = 1 ∨ f u = -1) ∧ (violatedLines (cfg 3 cczMask) f).card = 0 :=
  degree_of_certificate (by norm_num) cczMask cczNeg 28 336 0 14 (by norm_num) (by decide)
    ccz_card ccz_flags ccz_witness (by norm_num) (by norm_num)

/-- **Three qubits, all 63 observables.**  The contextuality degree is exactly 63. -/
theorem hoggar_degree :
    (∀ f : Pt 3 → ℝ, (∀ u ∈ cfg 3 hoggarMask, f u = 1 ∨ f u = -1) →
        63 ≤ (violatedLines (cfg 3 hoggarMask) f).card) ∧
      ∃ f : Pt 3 → ℝ, (∀ u, f u = 1 ∨ f u = -1) ∧
        (violatedLines (cfg 3 hoggarMask) f).card = 63 :=
  degree_of_certificate (by norm_num) hoggarMask hoggarNeg 63 1890 63 21 (by norm_num) (by decide)
    hoggar_card hoggar_flags hoggar_witness (by norm_num) (by norm_num)

/-- **Four qubits, the hyperbolic quadric.**  The contextuality degree is exactly 315
(the theorem of Li, Gupta and Ganesh, here by the spectral route). -/
theorem quadric_degree :
    (∀ f : Pt 4 → ℝ, (∀ u ∈ cfg 4 quadricMask, f u = 1 ∨ f u = -1) →
        315 ≤ (violatedLines (cfg 4 quadricMask) f).card) ∧
      ∃ f : Pt 4 → ℝ, (∀ u, f u = 1 ∨ f u = -1) ∧
        (violatedLines (cfg 4 quadricMask) f).card = 315 :=
  degree_of_certificate (by norm_num) quadricMask quadricNeg 135 9450 315 45 (by norm_num)
    (by decide) quadric_card quadric_flags quadric_witness (by norm_num) (by norm_num)

/-- **Four qubits, the pivot configuration.**  135 observables that do not form a quadric, with
their 1095 contexts: every noncontextual assignment violates at least 75 contexts, and some
assignment violates exactly 75. -/
theorem pivot_degree :
    (∀ f : Pt 4 → ℝ, (∀ u ∈ cfg 4 pivotMask, f u = 1 ∨ f u = -1) →
        75 ≤ (violatedLines (cfg 4 pivotMask) f).card) ∧
      ∃ f : Pt 4 → ℝ, (∀ u, f u = 1 ∨ f u = -1) ∧
        (violatedLines (cfg 4 pivotMask) f).card = 75 :=
  degree_of_certificate (by norm_num) pivotMask pivotNeg 135 6570 75 45 (by norm_num) (by decide)
    pivot_card pivot_flags pivot_witness (by norm_num) (by norm_num)

theorem pivot_contexts : (contexts (cfg 4 pivotMask)).card = 1095 :=
  contexts_of_flags pivotMask 1095 (by decide) pivot_flags

/-- **Five qubits, 496 observables.**  The support of Cieśliński's state, with its 10880
contexts: every noncontextual assignment violates at least 480 contexts, and some assignment
violates exactly 480. -/
theorem cieslinski5_degree :
    (∀ f : Pt 5 → ℝ, (∀ u ∈ cfg 5 cieslinski5Mask, f u = 1 ∨ f u = -1) →
        480 ≤ (violatedLines (cfg 5 cieslinski5Mask) f).card) ∧
      ∃ f : Pt 5 → ℝ, (∀ u, f u = 1 ∨ f u = -1) ∧
        (violatedLines (cfg 5 cieslinski5Mask) f).card = 480 :=
  degree_of_certificate (by norm_num) cieslinski5Mask cieslinski5Neg 496 65280 480 124
    (by norm_num) (by decide) cieslinski5_card cieslinski5_flags cieslinski5_witness
    (by norm_num) (by norm_num)

theorem cieslinski5_contexts : (contexts (cfg 5 cieslinski5Mask)).card = 10880 :=
  contexts_of_flags cieslinski5Mask 10880 (by decide) cieslinski5_flags

end HoggarBound
