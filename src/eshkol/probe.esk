;; probe of the Eshkol features the lab needs
(define (popcount x)
  (let loop ((x x) (c 0))
    (if (= x 0) c (loop (quotient x 2) (+ c (remainder x 2))))))
(display (popcount 13)) (newline)
(define v (make-vector 5 0))
(vector-set! v 2 7)
(display (vector-ref v 2)) (newline)
(define (cube-sum p) (+ (* (vector-ref p 0) (vector-ref p 1) (vector-ref p 2)) (* 2.0 (vector-ref p 0))))
(display (gradient cube-sum (vector 1.0 2.0 3.0))) (newline)
(display (derivative (lambda (x) (* x x x)) 2.0)) (newline)
(display (bitwise-and 12 10)) (newline)
(display (bitwise-xor 12 10)) (newline)
(display (exact->inexact 1/3)) (newline)
(define (count-up n) (let loop ((i 0) (acc 0)) (if (= i n) acc (loop (+ i 1) (+ acc i)))))
(display (count-up 100000)) (newline)
