;; saturated.esk - the four-qubit pivot configuration, written in Eshkol (Tsotchke's Scheme with built-in
;; automatic differentiation).  An independent re-implementation: no code is shared with the C, Python,
;; JavaScript or Lean versions.
;;
;;   Part A  the pivot state (|3> + |7> + |11> + |12> + |13> + i|14>)/sqrt(6): every Pauli expectation
;;           value is 0 or +-1/3, and exactly 135 are non-zero.
;;   Part B  the 135 observables with non-zero expectation contain 1095 contexts; the signs of the
;;           expectation values violate exactly 75 of them, and 1095 - 2*75 = 945 is the spectral floor.
;;   Part C  automatic differentiation: the cubic form T(x) = sum over these contexts of s x_u x_v x_w
;;           takes the value (D-1)(D-2)/6 = 35 at the vector of expectation values, and its exact
;;           reverse-mode gradient there equals ((D-2)/2) x = 7 x: every observable lies on the same
;;           excess of satisfied over violated contexts.
;;
;; run:  eshkol-run -r src/eshkol/saturated.esk

(define (popcount x)
  (let loop ((x x) (c 0))
    (if (= x 0) c (loop (quotient x 2) (+ c (remainder x 2))))))

(define (xpart v) (remainder v 16))
(define (zpart v) (quotient v 16))

(define (commute? u v)
  (= 0 (remainder (+ (popcount (bitwise-and (xpart u) (zpart v)))
                     (popcount (bitwise-and (zpart u) (xpart v)))) 2)))

;; sign s with P_u P_v P_{u+v} = s * identity (u, v commuting)
(define (line-sign u v)
  (let* ((au (xpart u)) (cu (zpart u)) (av (xpart v)) (cv (zpart v))
         (k (remainder (+ (popcount (bitwise-and au cu))
                          (popcount (bitwise-and av cv))
                          (* 2 (popcount (bitwise-and cu av)))
                          (* 3 (popcount (bitwise-and (bitwise-xor au av) (bitwise-xor cu cv)))))
                       4)))
    (if (= k 0) 1 -1)))

;; ---------------------------------------------------------------- Part A: the state
(define amp (/ 1.0 (sqrt 6.0)))
(define psi-re (make-vector 16 0.0))
(define psi-im (make-vector 16 0.0))
(vector-set! psi-re 3 amp) (vector-set! psi-re 7 amp) (vector-set! psi-re 11 amp)
(vector-set! psi-re 12 amp) (vector-set! psi-re 13 amp) (vector-set! psi-im 14 amp)

;; <psi| i^k X^a Z^c |psi>, real because the operator is Hermitian
(define (expectation v)
  (let* ((a (xpart v)) (c (zpart v)) (k (remainder (popcount (bitwise-and a c)) 4)))
    (let loop ((x 0) (re 0.0) (im 0.0))
      (if (= x 16)
          (cond ((= k 0) re) ((= k 1) (- 0.0 im)) ((= k 2) (- 0.0 re)) (else im))
          (let* ((y (bitwise-xor x a))
                 (s (if (= 1 (remainder (popcount (bitwise-and c x)) 2)) -1.0 1.0))
                 (br (vector-ref psi-re y)) (bi (vector-ref psi-im y))
                 (kr (vector-ref psi-re x)) (ki (vector-ref psi-im x)))
            (loop (+ x 1)
                  (+ re (* s (+ (* br kr) (* bi ki))))
                  (+ im (* s (- (* br ki) (* bi kr))))))))))

(define xstar (make-vector 256 0.0))
(define fstar (make-vector 256 1))
(define in-s (make-vector 256 0))

;; returns the largest distance of |<P>| from the nearer of 0 and 1/3
(define (fill-expectations!)
  (let loop ((v 1) (maxdev 0.0))
    (if (= v 256) maxdev
        (let* ((e (expectation v))
               (d0 (abs e)) (d1 (abs (- (abs e) (/ 1.0 3.0))))
               (dev (if (< d0 d1) d0 d1)))
          (if (< d1 d0)
              (begin (vector-set! xstar v e)
                     (vector-set! in-s v 1)
                     (vector-set! fstar v (if (>= e 0.0) 1 -1)))
              0)
          (loop (+ v 1) (if (> dev maxdev) dev maxdev))))))
(define maxdev-a (fill-expectations!))

(define (count-points)
  (let loop ((v 1) (acc 0))
    (if (= v 256) acc (loop (+ v 1) (+ acc (vector-ref in-s v))))))
(define points (count-points))
(display "A pivot state: observables with non-zero expectation=") (display points)
(display " max distance of |<P>| from {0, 1/3}=") (display maxdev-a) (newline)

;; ---------------------------------------------------------------- Part B: contexts inside the support
(define (line? u v)
  (and (= 1 (vector-ref in-s u)) (= 1 (vector-ref in-s v))
       (> (bitwise-xor u v) v) (= 1 (vector-ref in-s (bitwise-xor u v)))
       (commute? u v)))

(define (count-lines)
  (let loop-u ((u 1) (acc 0))
    (if (= u 256) acc
        (loop-u (+ u 1)
                (let loop-v ((v (+ u 1)) (acc acc))
                  (if (>= v 256) acc
                      (loop-v (+ v 1) (if (line? u v) (+ acc 1) acc))))))))
(define L (count-lines))
(define U (make-vector L 0)) (define V (make-vector L 0))
(define W (make-vector L 0)) (define S (make-vector L 0))

(define (fill-lines!)
  (let loop-u ((u 1) (idx 0))
    (if (= u 256) idx
        (loop-u (+ u 1)
                (let loop-v ((v (+ u 1)) (idx idx))
                  (if (>= v 256) idx
                      (if (line? u v)
                          (begin
                            (vector-set! U idx u) (vector-set! V idx v)
                            (vector-set! W idx (bitwise-xor u v))
                            (vector-set! S idx (line-sign u v))
                            (loop-v (+ v 1) (+ idx 1)))
                          (loop-v (+ v 1) idx))))))))
(fill-lines!)

(define (violations f)
  (let loop ((i 0) (acc 0))
    (if (= i L) acc
        (loop (+ i 1)
              (if (= (* (vector-ref f (vector-ref U i)) (vector-ref f (vector-ref V i)) (vector-ref f (vector-ref W i)))
                     (vector-ref S i))
                  acc (+ acc 1))))))
(define viol (violations fstar))
(display "B pivot configuration: contexts=") (display L)
(display " violated by the signs of the state=") (display viol)
(display " satisfied-minus-violated=") (display (- L (* 2 viol))) (display " (floor 945)") (newline)

;; ---------------------------------------------------------------- Part C: automatic differentiation
(define (cubic-form x)
  (let loop ((i 0) (acc 0.0))
    (if (= i L) acc
        (loop (+ i 1)
              (+ acc (* (vector-ref S i)
                        (vector-ref x (vector-ref U i))
                        (vector-ref x (vector-ref V i))
                        (vector-ref x (vector-ref W i))))))))

(define t-star (cubic-form xstar))
(define grad-star (gradient cubic-form xstar))
(define (max-grad-residual)
  (let loop ((v 1) (m 0.0))
    (if (= v 256) m
        (let ((r (abs (- (vector-ref grad-star v) (* 7.0 (vector-ref xstar v))))))
          (loop (+ v 1) (if (> r m) r m))))))
(define grad-res (max-grad-residual))
(display "C cubic form at the Pauli vector of the pivot state: T=") (display t-star)
(display " (prediction 35); max|grad T - 7 x|=") (display grad-res) (newline)

(define all-ok
  (and (= points 135) (< maxdev-a 1e-12) (= L 1095) (= viol 75)
       (< (abs (- t-star 35.0)) 1e-10) (< grad-res 1e-10)))
(display (if all-ok "ESHKOL-SATURATED-PASS" "ESHKOL-SATURATED-FAIL")) (newline)
